 		cat <<EOF
-%package      -n kmod-${kmodname}${kernel_variant}
+%package      -n %{kmod_pkg_name}${kernel_variant}
 Summary:         Metapackage which tracks in ${kmodname} kernel module for newest kernel${kernel_variant}
 Group:           System Environment/Kernel
 
 Provides:        ${kmodname}-kmod = %{?epoch:%{epoch}:}%{version}-%{release}
-Requires:        kmod-${kmodname}-${kernel_uname_r} >= %{?epoch:%{epoch}:}%{version}-%{release}
+Requires:        %{package_kmod_name} >= %{?epoch:%{epoch}:}%{version}-%{release}
 %{?KmodsMetaRequires:Requires: %{?KmodsMetaRequires}}
 EOF
 
 		cat <<EOF
 
-%description  -n kmod-${kmodname}${kernel_variant}
+%description  -n %{kmod_pkg_name}${kernel_variant}
 This is a meta-package without payload which sole purpose is to require the
 ${kmodname} kernel module(s) for the newest kernel${kernel_variant}.
 to make sure you get it together with a new kernel.
 
-%files        -n kmod-${kmodname}${kernel_variant}
+%files        -n %{kmod_pkg_name}${kernel_variant}
 %defattr(644,root,root,755)
 
 
@@ -335,11 +461,27 @@ print_customrpmtemplate ()
 	local first_kernel_custom=""
 	local first_kernel_redhat=""
 	local first_kernel_redhat_variant=""
+	local seen_kabi_baselines=""
 
 	for kernel in ${1}
 	do
+		# Deduplicate kernels that share the same kABI baseline.
+		# On RHEL, errata kernels (e.g. 5.14.0-687.49.1 through
+		# 5.14.0-687.54.1) all map to the same kABI-baseline
+		# package name (kmod-xxx-5.14.0-687.el9_8).  Generating
+		# duplicate %package definitions causes rpmbuild to fail.
+		# On Fedora each kernel has a unique short name, so no
+		# kernels are skipped.
+		init_kernel_uname_r_vars "${kernel}"
+		local kabi_key="${kernel_uname_r_short:-${kernel}}"
+		case " ${seen_kabi_baselines} " in
+			*" ${kabi_key} "*) continue ;;
+		esac
+		seen_kabi_baselines="${seen_kabi_baselines} ${kabi_key}"
+
 		if [[ -e "${prefix}/lib/modules/${kernel}/build/Makefile" ]]; then
 			kernel_versions="${kernel_versions}${kernel}___${prefix}/lib/modules/${kernel}/build/ "
+			print_rpmtemplate_macros_pkg_name_version "${kernel}"
 			print_rpmtemplate_per_kmodpkg --custom "${kernel}"
 
 			if [[ -n "${devel}" ]]; then
@@ -350,6 +492,7 @@ print_customrpmtemplate ()
 			kernel_versions="${kernel_versions}${kernel}___${buildroot}%{_usrsrc}/kernels/${kernel} "
 
 			local kernel_verrelarch=${kernel%%${kernels_known_variants}}
+			print_rpmtemplate_macros_pkg_name_version "${kernel}"
 			print_rpmtemplate_per_kmodpkg --redhat ${kernel} ${kernel##${kernel_verrelarch}}
 
 			if [[ -n "${devel}" ]]; then
@@ -391,14 +534,25 @@ print_rpmtemplate ()
 
